@model MyBookingsViewModel
@{
    ViewData["Title"] = "Потвърди номера си";
}
<section class="page-hero compact">
    <div class="container">
        <span class="eyebrow">ПРОВЕРКА</span>
        <h1>Въведи кода<br /><em>от съобщението.</em></h1>
        <p>Ако номерът има резервации, изпратихме 6-цифрен код. Валиден е 5 минути.</p>
    </div>
</section>

<section class="section">
    <div class="container narrow">
        <div class="lookup-card">
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-danger">@Model.Message</div>
            }

            <form asp-action="VerifyCode" method="post">
                <input type="hidden" name="phone" value="@Model.Phone" />
                <label for="code" class="form-label">Код</label>
                <div class="lookup-row">
                    <input id="code" name="code" class="form-control form-control-lg" inputmode="numeric"
                           autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required />
                    <button type="submit" class="btn btn-dark btn-lg">Потвърди →</button>
                </div>
            </form>

            <form asp-action="Login" method="post" class="mt-3">
                <input type="hidden" name="phone" value="@Model.Phone" />
                <button type="submit" class="btn btn-outline-dark">Изпрати нов код</button>
            </form>
        </div>
    </div>
</section>
