@model MyBookingsViewModel
@{
    ViewData["Title"] = "Моите часове";
}
<section class="page-hero compact">
    <div class="container">
        <span class="eyebrow">МОИТЕ ЧАСОВЕ</span>
        <h1>Твоите<br /><em>часове.</em></h1>
        <p>Влез с телефонния номер, с който си резервирал, за да видиш или отмениш часовете си.</p>
    </div>
</section>

<section class="section appointments-section">
    <div class="container narrow">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info">@Model.Message</div>
        }

        @if (!Model.IsSignedIn)
        {
            <form asp-action="Login" method="post" class="lookup-card">
                <label for="phone" class="form-label">Телефонен номер</label>
                <div class="lookup-row">
                    <input id="phone" name="phone" value="@Model.Phone" class="form-control form-control-lg"
                           placeholder="0888 123 456" inputmode="tel" autocomplete="tel" required />
                    <button type="submit" class="btn btn-dark btn-lg">Изпрати код →</button>
                </div>
            </form>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <strong>@Model.ClientName</strong>
                    <div class="text-muted">@Model.MaskedPhone</div>
                </div>
                <form asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-dark">Изход</button>
                </form>
            </div>

            @if (Model.Bookings.Count == 0)
            {
                <div class="empty-state">
                    <span>○</span>
                    <h3>Още нямаш резервации</h3>
                    <p>Запази първия си час – отнема по-малко от минута.</p>
                    <a class="btn btn-gold" asp-controller="Booking" asp-action="Index">Запази час →</a>
                </div>
            }
            else
            {
                <div class="appointment-list">
                    @foreach (var item in Model.Bookings)
                    {
                        var statusClass = item.Status switch
                        {
                            AppointmentStatus.Confirmed => "confirmed",
                            AppointmentStatus.Cancelled => "cancelled",
                            AppointmentStatus.Completed => "completed",
                            _ => "pending"
                        };
                        var statusText = item.Status switch
                        {
                            AppointmentStatus.Confirmed => "Потвърдена",
                            AppointmentStatus.Cancelled => "Отказана",
                            AppointmentStatus.Completed => "Завършена",
                            _ => "Изчаква"
                        };
                        <article class="appointment-card">
                            <div class="appointment-date">
                                <strong>@item.AppointmentDate.ToString("dd")</strong>
                                <span>@item.AppointmentDate.ToString("MMM", new System.Globalization.CultureInfo("bg-BG")).ToUpper()</span>
                            </div>
                            <div class="appointment-main">
                                <h3>@item.ServiceName</h3>
                                <p>@item.BarberName · @item.AppointmentDate.ToString("HH:mm") · @item.Price.ToString("0.00") €</p>
                            </div>
                            <span class="status @statusClass">@statusText</span>
                            @if (item.CanCancel)
                            {
                                <form asp-action="Cancel" method="post"
                                      onsubmit="return confirm('Сигурни ли сте, че искате да отмените този час?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="cancel-link">Отмени</button>
                                </form>
                            }
                        </article>
                    }
                </div>
            }
        }
    </div>
</section>
