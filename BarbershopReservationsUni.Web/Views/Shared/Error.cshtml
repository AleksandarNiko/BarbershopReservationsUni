@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}
<section class="success-page">
    <div class="container">
        <div class="success-card">
            <div class="success-icon error-icon">!</div>
            <span class="eyebrow dark">НЕЩО СЕ ОБЪРКА</span>
            <h1>Възникна<br /><em>грешка.</em></h1>
            <p>Моля, опитай отново или се върни към началната страница.</p>
            @if (Model.ShowRequestId)
            {
                <small class="request-id">Request ID: @Model.RequestId</small>
            }
            <a class="btn btn-gold btn-lg" asp-controller="Home" asp-action="Index">Към началото →</a>
        </div>
    </div>
</section>
