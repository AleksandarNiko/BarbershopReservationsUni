@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sharp & Co. - модерна бръснарница с онлайн резервации." />
    <title>@ViewData["Title"] - Sharp & Co.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">S</span>
                <span>SHARP<span class="brand-accent">&</span>CO.</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Отвори меню">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                    <li><a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Начало</a></li>
                    <li><a class="nav-link @(currentController == "Services" ? "active" : "")" asp-controller="Services" asp-action="Index">Услуги</a></li>
                    <li><a class="nav-link @(currentController == "Barbers" ? "active" : "")" asp-controller="Barbers" asp-action="Index">Екип</a></li>
                    <li><a class="nav-link @(currentController == "MyBookings" ? "active" : "")" asp-controller="MyBookings" asp-action="Index">Моите часове</a></li>
                    <li><a class="btn btn-gold nav-book" asp-controller="Booking" asp-action="Index">Запази час <span>→</span></a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main>
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <a class="brand footer-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">S</span><span>SHARP<span class="brand-accent">&</span>CO.</span>
                </a>
                <p>Класическо майсторство. Модерен подход.<br />Твоят стил започва от стола.</p>
            </div>
            <div>
                <h6>Навигация</h6>
                <a asp-controller="Services" asp-action="Index">Услуги</a>
                <a asp-controller="Barbers" asp-action="Index">Екип</a>
                <a asp-controller="Booking" asp-action="Index">Резервация</a>
            </div>
            <div>
                <h6>Контакти</h6>
                <span>ул. Main Street 21, Пловдив</span>
                <span>+359 888 123 456</span>
                <span>Пон–Съб · 09:00–19:00</span>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year Sharp & Co.</span>
            <a asp-controller="Home" asp-action="Privacy">Политика за поверителност</a>
        </div>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
